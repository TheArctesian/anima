# The Anima broker socket (R-055, VP-8). Install as /etc/systemd/system/anima-broker.socket
# (harden.sh broker). Only the hub container's user (10001) may connect; systemd starts one
# anima-broker@.service for each connection and refuses a second while one runs.
[Unit]
Description=Anima broker socket (R-055, VP-8)

[Socket]
ListenStream=/run/anima-broker/broker.sock
SocketUser=10001
SocketGroup=10001
SocketMode=0600
DirectoryMode=0755
Accept=yes
MaxConnections=1

[Install]
WantedBy=sockets.target
