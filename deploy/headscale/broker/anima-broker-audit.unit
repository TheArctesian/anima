# The Anima broker audit (vpn-plan.md Section 5.1, H2): checks the nodes the broker made and
# undoes a wrong result, also while the hub is silent. Install as
# /etc/systemd/system/anima-broker-audit.service (harden.sh broker); anima-broker-audit.timer
# starts it. flock serialises it with the socket's requests (anima-broker@.service).
[Unit]
Description=Anima broker audit

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -w 10 /var/lib/anima-broker/lock /usr/local/libexec/anima-broker audit
StandardInput=null
StandardOutput=journal
StandardError=journal
# The same user and sandbox as anima-broker@.service.
User=root
StateDirectory=anima-broker
StateDirectoryMode=0700
Environment=DOCKER_CONFIG=/var/lib/anima-broker/docker
# A oneshot unit is limited by TimeoutStartSec, not RuntimeMaxSec.
TimeoutStartSec=60
UMask=0077
LimitCORE=0

# Sandbox: the same as anima-broker@.unit.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/anima/headscale
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# M3. Run on the VPS on 2026-11-11: `~@resources` killed Bun (SIGSYS on sched_setscheduler), so
# only @privileged is denied. If `anima-broker check` fails after an update, see README.md step 4.
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
