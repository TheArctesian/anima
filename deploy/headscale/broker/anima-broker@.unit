# One Anima broker request (R-055, VP-8). Install as /etc/systemd/system/anima-broker@.service
# (harden.sh broker); anima-broker.socket starts one for each connection. flock serialises it
# with the audit timer's run (anima-broker-audit.service, H2): only one reads and writes the
# state. 8 s for the lock, 5 s for the request line and the 45 s request deadline fit in 60 s.
[Unit]
Description=Anima broker request

[Service]
ExecStart=/usr/bin/flock -w 8 /var/lib/anima-broker/lock /usr/local/libexec/anima-broker
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Root only to connect to /run/docker.sock; that needs no capability, so the bounding set is empty.
User=root
StateDirectory=anima-broker
StateDirectoryMode=0700
Environment=DOCKER_CONFIG=/var/lib/anima-broker/docker
RuntimeMaxSec=60
UMask=0077
# A core dump could hold a pre-auth key.
LimitCORE=0

# Sandbox. /run/docker.sock is a file-system socket: PrivateNetwork, AF_UNIX only and an empty
# capability set still let root connect to it. MemoryDenyWriteExecute is left out (Bun has a
# JIT).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/anima/headscale
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# M3. Run on the VPS on 2026-11-11: `~@resources` killed Bun (SIGSYS on sched_setscheduler), so
# only @privileged is denied. If `anima-broker check` fails after an update, see README.md step 4.
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
