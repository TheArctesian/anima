# One Anima broker request (R-055, VP-8). Install as /etc/systemd/system/anima-broker@.service
# (harden.sh broker); anima-broker.socket starts one for each connection.
[Unit]
Description=Anima broker request

[Service]
ExecStart=/usr/local/libexec/anima-broker
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Root only to connect to /run/docker.sock; that needs no capability, so the bounding set is empty.
User=root
StateDirectory=anima-broker
StateDirectoryMode=0700
Environment=DOCKER_CONFIG=/var/lib/anima-broker/docker
RuntimeMaxSec=60
UMask=0077
# A core dump could hold a pre-auth key.
LimitCORE=0

# Sandbox. /run/docker.sock is a file-system socket: PrivateNetwork, AF_UNIX only and an empty
# capability set still let root connect to it. MemoryDenyWriteExecute is left out (Bun has a
# JIT); SystemCallFilter waits for a run on the VPS (vpn-build.md B2).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/anima/headscale
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
