# VPS: daily Headscale backup to the home rest-server (VPS-006, decision D-12).
# Install as /etc/systemd/system/headscale-backup.service (see README.md).
[Unit]
Description=Headscale backup to the home rest-server
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/headscale-backup
Environment=HEADSCALE_DIR=/opt/anima/headscale
# systemd copies the operator's root-only files into a private, per-run credentials
# folder ($CREDENTIALS_DIRECTORY, %d) that only this unit can read.
LoadCredential=restic-repository:/etc/anima/backup/restic-repository
LoadCredential=restic-password:/etc/anima/backup/restic-password
Environment=RESTIC_REPOSITORY_FILE=%d/restic-repository
Environment=RESTIC_PASSWORD_FILE=%d/restic-password
CacheDirectory=headscale-backup
CacheDirectoryMode=0700
UMask=0077
# A core dump of restic or sqlite3 could hold the keys or the password.
LimitCORE=0

# Sandbox. Runs as root only so that it can read the root-owned 0600 key files by
# ownership; that needs no capability, so the bounding set is empty.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/anima/headscale
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# The only peer is the rest-server on the home LAN, reached over the VPN subnet route.
IPAddressDeny=any
IPAddressAllow=10.10.0.0/24
