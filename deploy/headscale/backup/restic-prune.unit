# Home Linux PC: apply backup retention to the local repository (VPS-006, decision D-12).
# Install as /etc/systemd/system/restic-prune.service (see README.md).
[Unit]
Description=Retention and prune for the Headscale backups

[Service]
Type=oneshot
User=restic
Group=restic
ExecStart=/usr/local/bin/restic-prune
Environment=RESTIC_REPOSITORY_PATH=/srv/restic/headscale-vps/headscale
# The same encryption password the VPS uses; the operator also keeps a copy offline.
LoadCredential=restic-password:/etc/restic/headscale-password
Environment=RESTIC_PASSWORD_FILE=%d/restic-password
CacheDirectory=restic-prune
CacheDirectoryMode=0700
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/restic/headscale-vps/headscale
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Works on the local folder only.
PrivateNetwork=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
