# Home Linux PC: restic rest-server that receives the VPS backups (VPS-006, decision D-12).
# Install as /etc/systemd/system/rest-server.service (see README.md).
# --append-only: a client can add snapshots but never delete or overwrite them, so a
# compromised VPS cannot destroy old backups. --private-repos: the user headscale-vps
# may only use /srv/restic/headscale-vps/.
[Unit]
Description=restic rest-server for off-site backups
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=restic
Group=restic
# Holds HOME_PC_LAN_IP=10.10.0.X, the home PC's LAN address; not a secret.
EnvironmentFile=/etc/restic/rest-server.env
ExecStart=/usr/local/bin/rest-server --listen ${HOME_PC_LAN_IP}:8000 --path /srv/restic --append-only --private-repos --htpasswd-file /etc/restic/htpasswd
Restart=on-failure
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/restic
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# Clients: the tailnet (the VPS arrives from its tailnet address) and the home LAN.
IPAddressDeny=any
IPAddressAllow=localhost 10.10.0.0/24 100.64.0.0/10 fd7a:115c:a1e0::/48

[Install]
WantedBy=multi-user.target
