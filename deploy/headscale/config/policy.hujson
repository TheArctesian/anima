// Anima tailnet access policy for Headscale v0.29.7 (VPN-004).
// Only `grants` are used: anything no grant names is denied. Never use `*` or
// `autogroup:` selectors, and never add `autoApprovers`: the operator approves routes.
// Client computers are personal nodes of `operator`, never tagged, so their keys keep
// the 180-day expiry; the hub, routers and agents are tagged and do not expire. VPN-003
// names only the hub and routers.
{
  // Every owner list is empty, so no node can claim a tag when it registers: with an
  // owner, a client re-registered by its user could advertise tag:hub and lose its
  // expiry (VPN-003). Tags are applied only by the operator through the CLI, with a
  // tagged pre-auth key or `headscale nodes tag`.
  "tagOwners": {
    "tag:hub": [],
    // An agent-only device (anima-agent, MET-020, R-084): one with no operator in front of it.
    "tag:agent": [],
    // Every subnet router carries tag:router and the tag of its own site.
    "tag:router": [],
    "tag:site-home": [],
    "tag:site-office1": [],
    "tag:site-office2": [],
  },

  // One subnet per site; they must not overlap (VPN-001).
  "hosts": {
    "site-home": "10.10.0.0/24",
    "site-office1": "10.20.0.0/24",
    "site-office2": "10.30.0.0/24",
    // Client computers the operator added as devices (R-061). Each is one /32 tailnet
    // address, reached only by the hub and only on the ports its grant names.
    "device-stephens-mac": "100.64.0.2/32",
    "device-pop-os": "100.64.0.3/32",
  },

  "grants": [
    // Clients reach the hub API and SSH on the VPS.
    {"src": ["operator@"], "dst": ["tag:hub"], "ip": ["tcp:443", "tcp:22"]},
    // Clients reach every device at every site.
    {"src": ["operator@"], "dst": ["site-home", "site-office1", "site-office2"], "ip": ["*"]},
    // The hub reaches every device for checks, metrics and sessions.
    {"src": ["tag:hub"], "dst": ["site-home", "site-office1", "site-office2"], "ip": ["*"]},
    // Each router reaches only its own site subnet.
    {"src": ["tag:site-home"], "dst": ["site-home"], "ip": ["*"]},
    {"src": ["tag:site-office1"], "dst": ["site-office1"], "ip": ["*"]},
    {"src": ["tag:site-office2"], "dst": ["site-office2"], "ip": ["*"]},
    // The hub reaches a client the operator added as a device on SSH and VNC (Screen
    // Sharing), TCP only (R-061). Each RDP or VNC client device gets one host entry and
    // one grant like this, from tag:hub only.
    {"src": ["tag:hub"], "dst": ["device-stephens-mac"], "ip": ["tcp:22", "tcp:5900"]},
    {"src": ["tag:hub"], "dst": ["device-pop-os"], "ip": ["tcp:22", "tcp:5900"]},
    // An agent device dials the hub's HTTPS port and nothing else (MET-020, R-084). No
    // grant names tag:agent as a destination: the agent listens on no port.
    {"src": ["tag:agent"], "dst": ["tag:hub"], "ip": ["tcp:443"]},
    // No other grant targets a client address: devices, routers and the hub cannot start
    // a connection to any other client; replies to permitted connections still flow.
  ],

  // A smoke test, run through the running server with
  // `headscale policy check --file <file>` (the flag
  // `--bypass-grpc-and-access-database-directly` is only for a stopped server). Headscale passes
  // a deny row when any one source address is denied; `bun test` is the authoritative
  // check, where every source address must be denied. A row without `proto` is checked
  // for tcp, udp and icmp. Headscale passes an accept row without `proto` if any one of
  // them is allowed, while `bun test` requires all three, so accept rows always name
  // `proto`. Headscale needs a node for every tag a row names and refuses the whole policy,
  // on reload too, while one is missing. Each router's group of rows (its tags, and the
  // rows with its LAN address as source) waits in `ROUTER_ROWS` in tests/policy.test.ts and
  // moves here once that router is enrolled.
  "tests": [
    // Only operator@, tag:hub and addresses: identities that exist before any router enrols.
    {
      "src": "operator@",
      "proto": "tcp",
      "accept": ["tag:hub:443", "tag:hub:22", "10.10.0.5:22", "10.20.0.5:443", "10.30.0.5:3389"],
      "deny": ["tag:hub:5432", "tag:hub:80", "operator@:22"],
    },
    {
      "src": "tag:hub",
      "proto": "tcp",
      "accept": ["10.10.0.5:161", "10.20.0.5:22", "10.30.0.5:5900", "100.64.0.2:22", "100.64.0.2:5900", "100.64.0.3:22", "100.64.0.3:5900"],
      "deny": ["operator@:443", "100.64.0.2:3389", "100.64.0.3:3389"],
    },
    {"src": "tag:hub", "deny": ["operator@:53", "100.64.0.2:3389", "100.64.0.3:3389"]},
  ],
}
