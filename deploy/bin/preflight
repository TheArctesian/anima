#!/bin/sh
# Checks the host before `docker compose up` (NET-003, DB-002). With no argument it checks
# all five things from the environment and exits 1 on the first failure:
#   address  ANIMA_HUB_ADDRESS is an IPv4 address in 100.64.0.0/10 (the VPN range).
#   public   ANIMA_VPS_PUBLIC_ADDRESS is a public IPv4 address (not VPN, private or reserved).
#   docker   the Docker Engine is version 28 or later (earlier engines let a routed LAN
#            neighbour reach unpublished container ports).
#   networks every ANIMA_*_SUBNET and ANIMA_HUB_IP_RANGE is inside 172.30.0.0/16, the range the VPS
#            firewall keeps off the VPN and the hub refuses as a site subnet; ANIMA_HUB_IP and
#            ANIMA_GUACD_IP differ and are outside ANIMA_HUB_IP_RANGE, so Docker gives neither to
#            another container (VP-13). Reads the environment, defaults as in compose.yaml.
#   secrets  every secret file of compose.yaml exists and is not empty in the secrets folder
#            (ANIMA_SECRETS_DIR, default deploy/secrets), and has the mode make-secrets sets:
#            0440, or 0400 for cloudflare_dns_token. updater_key_password may be empty.
# One argument pair checks one thing from the value given: `preflight address 100.64.0.1`.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
fail() {
    echo "preflight: $1" >&2
    exit 1
}

check_address() {
    ip=$1
    case $ip in
    *[!0-9.]* | '' | .* | *. | *..*) fail "ANIMA_HUB_ADDRESS '$ip' is not an IPv4 address" ;;
    esac
    oldifs=$IFS
    IFS=.
    # shellcheck disable=SC2086 # word splitting on dots is the point
    set -- $ip
    IFS=$oldifs
    [ "$#" -eq 4 ] || fail "ANIMA_HUB_ADDRESS '$ip' is not an IPv4 address"
    for part in "$@"; do
        case $part in
        0?*) fail "ANIMA_HUB_ADDRESS '$ip' has a leading zero in '$part'" ;;
        esac
        [ "${#part}" -le 3 ] && [ "$part" -le 255 ] || fail "ANIMA_HUB_ADDRESS '$ip' is not an IPv4 address"
    done
    # 100.64.0.0/10 is 100.64.0.0 to 100.127.255.255.
    if [ "$1" -ne 100 ] || [ "$2" -lt 64 ] || [ "$2" -gt 127 ]; then
        fail "ANIMA_HUB_ADDRESS '$ip' is not in 100.64.0.0/10; use the VPN address, never 0.0.0.0 or a public address"
    fi
}

# check_public_address ADDRESS: an IPv4 address that is not in the VPN range or a private range.
check_public_address() {
    ip=$1
    case $ip in
    *[!0-9.]* | '' | .* | *. | *..*) fail "ANIMA_VPS_PUBLIC_ADDRESS '$ip' is not an IPv4 address" ;;
    esac
    oldifs=$IFS
    IFS=.
    # shellcheck disable=SC2086 # word splitting on dots is the point
    set -- $ip
    IFS=$oldifs
    [ "$#" -eq 4 ] || fail "ANIMA_VPS_PUBLIC_ADDRESS '$ip' is not an IPv4 address"
    for part in "$@"; do
        case $part in
        0?*) fail "ANIMA_VPS_PUBLIC_ADDRESS '$ip' has a leading zero in '$part'" ;;
        esac
        [ "${#part}" -le 3 ] && [ "$part" -le 255 ] || fail "ANIMA_VPS_PUBLIC_ADDRESS '$ip' is not an IPv4 address"
    done
    private=
    if [ "$1" -eq 10 ] || [ "$1" -eq 127 ] || [ "$1" -eq 0 ] || [ "$1" -ge 224 ]; then private=1; fi
    if [ "$1" -eq 100 ] && [ "$2" -ge 64 ] && [ "$2" -le 127 ]; then private=1; fi
    if [ "$1" -eq 172 ] && [ "$2" -ge 16 ] && [ "$2" -le 31 ]; then private=1; fi
    if [ "$1" -eq 192 ] && [ "$2" -eq 168 ]; then private=1; fi
    if [ "$1" -eq 169 ] && [ "$2" -eq 254 ]; then private=1; fi
    # Documentation, benchmark and protocol ranges (RFC 5737, RFC 2544, RFC 6890).
    if [ "$1" -eq 192 ] && [ "$2" -eq 0 ] && { [ "$3" -eq 0 ] || [ "$3" -eq 2 ]; }; then private=1; fi
    if [ "$1" -eq 198 ] && { [ "$2" -eq 18 ] || [ "$2" -eq 19 ]; }; then private=1; fi
    if [ "$1" -eq 198 ] && [ "$2" -eq 51 ] && [ "$3" -eq 100 ]; then private=1; fi
    if [ "$1" -eq 203 ] && [ "$2" -eq 0 ] && [ "$3" -eq 113 ]; then private=1; fi
    [ -z "$private" ] || fail "ANIMA_VPS_PUBLIC_ADDRESS '$ip' is not a public address (VPN, private, loopback or reserved range)"
}

# ipv4_number NAME ADDRESS: ADDRESS (dotted IPv4, no leading zeros) as a number; fails naming NAME.
ipv4_number() {
    name=$1
    ip=$2
    case $ip in
    *[!0-9.]* | '' | .* | *. | *..*) fail "$name '$ip' is not an IPv4 address" ;;
    esac
    oldifs=$IFS
    IFS=.
    # shellcheck disable=SC2086 # word splitting on dots is the point
    set -- $ip
    IFS=$oldifs
    [ "$#" -eq 4 ] || fail "$name '$ip' is not an IPv4 address"
    for part in "$@"; do
        case $part in
        0?*) fail "$name '$ip' has a leading zero in '$part'" ;;
        esac
        [ "${#part}" -le 3 ] && [ "$part" -le 255 ] || fail "$name '$ip' is not an IPv4 address"
    done
    echo $((($1 << 24) + ($2 << 16) + ($3 << 8) + $4))
}

# anima_range NAME CIDR: CIDR is an IPv4 network inside 172.30.0.0/16; prints its first address
# and its size.
anima_range() {
    case $2 in
    */*) ;;
    *) fail "$1 '$2' is not a network (address/bits)" ;;
    esac
    bits=${2#*/}
    case $bits in
    '' | *[!0-9]*) fail "$1 '$2' is not a network (address/bits)" ;;
    esac
    first=$(ipv4_number "$1" "${2%/*}")
    if [ "$bits" -lt 16 ] || [ "$bits" -gt 32 ] || [ $((first >> 16)) -ne $(((172 << 8) + 30)) ]; then
        fail "$1 '$2' is not inside 172.30.0.0/16, the range the VPS firewall keeps off the VPN (VP-13)"
    fi
    echo "$first $((1 << (32 - bits)))"
}

check_networks() {
    for setting in "ANIMA_HUB_SUBNET=${ANIMA_HUB_SUBNET:-172.30.0.0/24}" \
        "ANIMA_DATABASE_SUBNET=${ANIMA_DATABASE_SUBNET:-172.30.1.0/24}" \
        "ANIMA_LOCALAPI_SUBNET=${ANIMA_LOCALAPI_SUBNET:-172.30.2.0/24}" \
        "ANIMA_ACME_SUBNET=${ANIMA_ACME_SUBNET:-172.30.4.0/24}"; do
        anima_range "${setting%%=*}" "${setting#*=}" >/dev/null
    done
    range=${ANIMA_HUB_IP_RANGE:-172.30.0.128/25}
    bounds=$(anima_range ANIMA_HUB_IP_RANGE "$range")
    hub=$(ipv4_number ANIMA_HUB_IP "${ANIMA_HUB_IP:-172.30.0.10}")
    guacd=$(ipv4_number ANIMA_GUACD_IP "${ANIMA_GUACD_IP:-172.30.0.20}")
    [ "$hub" -ne "$guacd" ] || fail "ANIMA_GUACD_IP is ANIMA_HUB_IP; guacd needs its own address, the VPS trusts the hub's (VP-13)"
    for fixed in "ANIMA_HUB_IP $hub" "ANIMA_GUACD_IP $guacd"; do
        # shellcheck disable=SC2086 # "first size" and "name number" are split on purpose
        set -- $bounds ${fixed#* }
        if [ "$3" -ge "$1" ] && [ "$3" -lt $(($1 + $2)) ]; then
            fail "${fixed%% *} is inside ANIMA_HUB_IP_RANGE '$range'; Docker could give it to another container (VP-13)"
        fi
    done
}

check_docker() {
    major=${1%%.*}
    case $major in
    '' | *[!0-9]*) fail "cannot read the Docker Engine version '$1'" ;;
    esac
    [ "$major" -ge 28 ] || fail "Docker Engine $1 is too old; use 28.0 or later"
}

# file_mode FILE: the permission bits in octal (GNU stat, else BSD stat for tests).
file_mode() {
    stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

check_secrets() {
    dir=$1
    for name in postgres_password owner_password hub_password owner_database_url \
        hub_database_url anima_key cloudflare_dns_token; do
        [ -s "$dir/$name" ] || fail "missing or empty secret file $dir/$name; run bin/make-secrets"
        wanted=440
        if [ "$name" = cloudflare_dns_token ]; then wanted=400; fi
        [ "$(file_mode "$dir/$name")" = "$wanted" ] ||
            fail "secret file $dir/$name does not have mode 0$wanted; rerun bin/make-secrets, which resets owners and modes"
    done
    # The R2 token files hold values from Cloudflare and the updater key is the operator's own
    # file, so make-secrets cannot make them (R-108, R-116).
    for name in r2_access_key_id r2_secret_access_key updater_key; do
        [ -s "$dir/$name" ] || fail "missing or empty secret file $dir/$name; see README, Release publishing"
        [ "$(file_mode "$dir/$name")" = 440 ] ||
            fail "secret file $dir/$name does not have mode 0440; see README, Release publishing"
    done
    # The updater key's password is empty for a key made with no password, so this file only has
    # to exist: -e, not -s (R-116).
    for name in updater_key_password; do
        [ -e "$dir/$name" ] || fail "missing secret file $dir/$name; see README, Release publishing"
        [ "$(file_mode "$dir/$name")" = 440 ] ||
            fail "secret file $dir/$name does not have mode 0440; see README, Release publishing"
    done
}

case ${1:-all} in
address) check_address "${2:-}" ;;
public) check_public_address "${2:-}" ;;
docker) check_docker "${2:-}" ;;
networks) check_networks ;;
secrets) check_secrets "${2:-}" ;;
all)
    check_address "${ANIMA_HUB_ADDRESS:-}"
    check_public_address "${ANIMA_VPS_PUBLIC_ADDRESS:-}"
    check_networks
    check_docker "$(docker version --format '{{.Server.Version}}')"
    check_secrets "${ANIMA_SECRETS_DIR:-$here/../secrets}"
    echo "preflight: ok"
    ;;
*) fail "unknown check '$1'" ;;
esac
