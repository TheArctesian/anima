#!/bin/sh
# Checks the host before `docker compose up` (NET-003, DB-002). With no argument it checks
# all four things from the environment and exits 1 on the first failure:
#   address  ANIMA_HUB_ADDRESS is an IPv4 address in 100.64.0.0/10 (the VPN range).
#   public   ANIMA_VPS_PUBLIC_ADDRESS is a public IPv4 address (not VPN, private or reserved).
#   docker   the Docker Engine is version 28 or later (earlier engines let a routed LAN
#            neighbour reach unpublished container ports).
#   secrets  every secret file of compose.yaml exists and is not empty in the secrets folder
#            (ANIMA_SECRETS_DIR, default deploy/secrets), and has the mode make-secrets sets:
#            0440, or 0400 for cloudflare_dns_token.
# One argument pair checks one thing from the value given: `preflight address 100.64.0.1`.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
fail() {
    echo "preflight: $1" >&2
    exit 1
}

check_address() {
    ip=$1
    case $ip in
    *[!0-9.]* | '' | .* | *. | *..*) fail "ANIMA_HUB_ADDRESS '$ip' is not an IPv4 address" ;;
    esac
    oldifs=$IFS
    IFS=.
    # shellcheck disable=SC2086 # word splitting on dots is the point
    set -- $ip
    IFS=$oldifs
    [ "$#" -eq 4 ] || fail "ANIMA_HUB_ADDRESS '$ip' is not an IPv4 address"
    for part in "$@"; do
        case $part in
        0?*) fail "ANIMA_HUB_ADDRESS '$ip' has a leading zero in '$part'" ;;
        esac
        [ "${#part}" -le 3 ] && [ "$part" -le 255 ] || fail "ANIMA_HUB_ADDRESS '$ip' is not an IPv4 address"
    done
    # 100.64.0.0/10 is 100.64.0.0 to 100.127.255.255.
    if [ "$1" -ne 100 ] || [ "$2" -lt 64 ] || [ "$2" -gt 127 ]; then
        fail "ANIMA_HUB_ADDRESS '$ip' is not in 100.64.0.0/10; use the VPN address, never 0.0.0.0 or a public address"
    fi
}

# check_public_address ADDRESS: an IPv4 address that is not in the VPN range or a private range.
check_public_address() {
    ip=$1
    case $ip in
    *[!0-9.]* | '' | .* | *. | *..*) fail "ANIMA_VPS_PUBLIC_ADDRESS '$ip' is not an IPv4 address" ;;
    esac
    oldifs=$IFS
    IFS=.
    # shellcheck disable=SC2086 # word splitting on dots is the point
    set -- $ip
    IFS=$oldifs
    [ "$#" -eq 4 ] || fail "ANIMA_VPS_PUBLIC_ADDRESS '$ip' is not an IPv4 address"
    for part in "$@"; do
        case $part in
        0?*) fail "ANIMA_VPS_PUBLIC_ADDRESS '$ip' has a leading zero in '$part'" ;;
        esac
        [ "${#part}" -le 3 ] && [ "$part" -le 255 ] || fail "ANIMA_VPS_PUBLIC_ADDRESS '$ip' is not an IPv4 address"
    done
    private=
    if [ "$1" -eq 10 ] || [ "$1" -eq 127 ] || [ "$1" -eq 0 ] || [ "$1" -ge 224 ]; then private=1; fi
    if [ "$1" -eq 100 ] && [ "$2" -ge 64 ] && [ "$2" -le 127 ]; then private=1; fi
    if [ "$1" -eq 172 ] && [ "$2" -ge 16 ] && [ "$2" -le 31 ]; then private=1; fi
    if [ "$1" -eq 192 ] && [ "$2" -eq 168 ]; then private=1; fi
    if [ "$1" -eq 169 ] && [ "$2" -eq 254 ]; then private=1; fi
    # Documentation, benchmark and protocol ranges (RFC 5737, RFC 2544, RFC 6890).
    if [ "$1" -eq 192 ] && [ "$2" -eq 0 ] && { [ "$3" -eq 0 ] || [ "$3" -eq 2 ]; }; then private=1; fi
    if [ "$1" -eq 198 ] && { [ "$2" -eq 18 ] || [ "$2" -eq 19 ]; }; then private=1; fi
    if [ "$1" -eq 198 ] && [ "$2" -eq 51 ] && [ "$3" -eq 100 ]; then private=1; fi
    if [ "$1" -eq 203 ] && [ "$2" -eq 0 ] && [ "$3" -eq 113 ]; then private=1; fi
    [ -z "$private" ] || fail "ANIMA_VPS_PUBLIC_ADDRESS '$ip' is not a public address (VPN, private, loopback or reserved range)"
}

check_docker() {
    major=${1%%.*}
    case $major in
    '' | *[!0-9]*) fail "cannot read the Docker Engine version '$1'" ;;
    esac
    [ "$major" -ge 28 ] || fail "Docker Engine $1 is too old; use 28.0 or later"
}

# file_mode FILE: the permission bits in octal (GNU stat, else BSD stat for tests).
file_mode() {
    stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

check_secrets() {
    dir=$1
    for name in postgres_password owner_password hub_password owner_database_url \
        hub_database_url anima_key cloudflare_dns_token; do
        [ -s "$dir/$name" ] || fail "missing or empty secret file $dir/$name; run bin/make-secrets"
        wanted=440
        if [ "$name" = cloudflare_dns_token ]; then wanted=400; fi
        [ "$(file_mode "$dir/$name")" = "$wanted" ] ||
            fail "secret file $dir/$name does not have mode 0$wanted; rerun bin/make-secrets, which resets owners and modes"
    done
}

case ${1:-all} in
address) check_address "${2:-}" ;;
public) check_public_address "${2:-}" ;;
docker) check_docker "${2:-}" ;;
secrets) check_secrets "${2:-}" ;;
all)
    check_address "${ANIMA_HUB_ADDRESS:-}"
    check_public_address "${ANIMA_VPS_PUBLIC_ADDRESS:-}"
    check_docker "$(docker version --format '{{.Server.Version}}')"
    check_secrets "${ANIMA_SECRETS_DIR:-$here/../secrets}"
    echo "preflight: ok"
    ;;
*) fail "unknown check '$1'" ;;
esac
