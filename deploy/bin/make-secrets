#!/bin/sh
# Makes the Compose secret files the hub deployment needs (DB-002, SEC-004, DNS-003).
#
# Usage: make-secrets [--cloudflare-token-stdin] [FOLDER]
#
# Run once on the host, as root. It creates only files that are missing, never overwrites
# one, and never prints a secret value. For a file that exists it keeps the content, checks
# that the content is usable, and sets the owner and mode again. Every file holds its value
# with no trailing newline, so a password and the database URL built from it match byte for
# byte.
#
# Folder: FOLDER, else ANIMA_SECRETS_DIR, else deploy/secrets beside this script's deploy
# folder. It must belong to the current user and not be writable by group or others. The
# script enters the folder once and uses relative names, so moving a parent folder while it
# runs cannot redirect a write.
# ANIMA_SECRETS_CHOWN=0 skips chown (tests, non-root use); modes are still set.
# ANIMA_ASSUME_TERMINAL=1 makes the script treat stdin as a terminal, which only selects the
# no-echo token prompt; it changes nothing about where or what the script writes (tests).
#
# A password you supply must use only A-Z a-z 0-9 . _ ~ - and have no trailing newline (it
# goes into a URL unescaped). The Cloudflare token (A-Z a-z 0-9 _ -) comes from the terminal
# prompt (no echo), from one line of stdin with --cloudflare-token-stdin, or from a file you
# make yourself.
set -eu
umask 077
LC_ALL=C
export LC_ALL
unset CDPATH

fail() {
    echo "make-secrets: $*" >&2
    exit 1
}

tmp=
cleanup() {
    if [ -n "$tmp" ]; then rm -f "$tmp"; fi
    stty echo 2>/dev/null || true
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM HUP

token_from_stdin=0
folder_argument=
for argument in "$@"; do
    case $argument in
        --cloudflare-token-stdin) token_from_stdin=1 ;;
        -*) fail "unknown option $argument" ;;
        *) folder_argument=$argument ;;
    esac
done

command -v openssl >/dev/null 2>&1 || fail "openssl is not installed or not on PATH"

here=$(cd "$(dirname "$0")" && pwd -P)
target=${folder_argument:-${ANIMA_SECRETS_DIR:-$here/../secrets}}
chown_files=${ANIMA_SECRETS_CHOWN:-1}

mkdir -p "$target"
cd "$target"
dir=$(pwd -P)
[ -n "$(find . -prune -user "$(id -u)")" ] || fail "$dir does not belong to the current user"
folder_mode=$(ls -ld .)
case $folder_mode in
    ?????w* | ????????w*) fail "$dir is writable by group or others" ;;
    *) ;;
esac

for name in postgres_password owner_password hub_password owner_database_url hub_database_url \
    anima_key cloudflare_dns_token; do
    if [ -L "$name" ]; then fail "$dir/$name is a symbolic link"; fi
done

# set_access FILE OWNER MODE: owner first, then mode.
set_access() {
    if [ "$chown_files" != 0 ]; then chown "$2" "$1"; fi
    chmod "$3" "$1"
}

# store NAME OWNER MODE VALUE: writes VALUE to a temp file, then moves it into place.
# A file that exists keeps its content and gets the owner and mode again.
store() {
    name=$1 owner=$2 mode=$3 value=$4
    if [ -e "$name" ]; then
        set_access "$name" "$owner" "$mode"
        return 0
    fi
    [ -n "$value" ] || fail "no value for $name; nothing stored"
    tmp=$(mktemp "./.$name.XXXXXX")
    printf '%s' "$value" >"$tmp"
    set_access "$tmp" "$owner" "$mode"
    mv "$tmp" "$name"
    tmp=
    echo "made $name"
}

# read_exact NAME: puts the file's bytes in $content, trailing newlines included.
read_exact() {
    content=$(cat "$1"; printf x)
    content=${content%x}
}

random_hex() {
    value=$(openssl rand -hex 32) || fail "openssl could not make a random value"
    case $value in
        *[!0-9a-f]*) fail "openssl returned an unexpected value" ;;
        *) ;;
    esac
    [ ${#value} -eq 64 ] || fail "openssl returned a value of the wrong length"
    printf '%s' "$value"
}

# is_key VALUE: base64 of exactly 32 bytes (43 characters whose last one has two zero bits, then "=").
is_key() {
    case $1 in
        *[!A-Za-z0-9+/=]*) return 1 ;;
        *) ;;
    esac
    [ ${#1} -eq 44 ] || return 1
    unpadded=${1%=}
    [ "$unpadded" != "$1" ] || return 1
    case $unpadded in
        *=*) return 1 ;;
        *[AEIMQUYcgkosw048]) return 0 ;;
        *) return 1 ;;
    esac
}

random_key() {
    value=$(openssl rand -base64 32) || fail "openssl could not make a random value"
    is_key "$value" || fail "openssl returned an unexpected value"
    printf '%s' "$value"
}

# ensure_password NAME: stores a password and leaves it in $password (made or supplied).
ensure_password() {
    if [ -e "$1" ]; then
        read_exact "$1"
        password=$content
        case $password in
            '' | *[!A-Za-z0-9._~-]*)
                fail "$1 must be non-empty, use only A-Z a-z 0-9 . _ ~ - and have no trailing newline"
                ;;
            *) ;;
        esac
    else
        password=$(random_hex) || exit 1
    fi
    store "$1" root:999 0440 "$password"
}

# ensure_url NAME USER PASSWORD: an existing file must equal the URL built from the password.
ensure_url() {
    url="postgres://$2:$3@postgres:5432/anima"
    if [ -e "$1" ]; then
        read_exact "$1"
        [ "$content" = "$url" ] || fail "$1 does not match the password file for $2"
    fi
    store "$1" root:10001 0440 "$url"
}

# read_token: puts the operator's token in $token, from the terminal or stdin.
read_token() {
    if [ -t 0 ] || [ "${ANIMA_ASSUME_TERMINAL:-0}" = 1 ]; then
        printf 'Cloudflare API token (Zone DNS Edit on anima.ing; input is hidden): ' >&2
        stty -echo
        IFS= read -r token || true
        stty echo
        printf '\n' >&2
    elif [ "$token_from_stdin" = 1 ]; then
        IFS= read -r token || true
    else
        echo "make-secrets: create $dir/cloudflare_dns_token (root:root, 0400) with the Cloudflare API token, or run this script in a terminal" >&2
        return 0
    fi
    token=${token%"$(printf '\r')"}
    case $token in
        '' | *[!A-Za-z0-9_-]*)
            token=
            fail "the Cloudflare token is empty or has characters other than A-Z a-z 0-9 _ -; cloudflare_dns_token not written"
            ;;
        *) ;;
    esac
}

hint_group() {
    if command -v getent >/dev/null 2>&1 && getent group "$1" >/dev/null 2>&1; then
        echo "make-secrets: note: gid $1 is also a group on this host ($(getent group "$1" | cut -d: -f1)); the files are readable by its members" >&2
    fi
}

ensure_password postgres_password
ensure_password owner_password
owner_password=$password
ensure_password hub_password
hub_password=$password
ensure_url owner_database_url anima_owner "$owner_password"
ensure_url hub_database_url anima_hub "$hub_password"

key=
if [ -e anima_key ]; then
    read_exact anima_key
    is_key "$content" || fail "anima_key is not base64 of exactly 32 bytes"
else
    key=$(random_key) || exit 1
fi
store anima_key root:10001 0440 "$key"

token=
if [ -e cloudflare_dns_token ]; then
    [ -s cloudflare_dns_token ] || fail "cloudflare_dns_token is empty"
else
    read_token
fi
if [ -n "$token" ] || [ -e cloudflare_dns_token ]; then
    store cloudflare_dns_token root:root 0400 "$token"
fi

if [ "$chown_files" != 0 ]; then
    hint_group 999
    hint_group 10001
fi
