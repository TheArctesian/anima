#!/bin/sh
# Makes the Compose secret files the hub deployment needs (DB-002, SEC-004, DNS-003).
#
# Usage: make-secrets [--cloudflare-token-stdin] [FOLDER]
#
# Run once on the host, as root. It creates only files that are missing, never overwrites
# one, and never prints a secret value. For a file that exists it keeps the content and sets
# the owner and mode again. Every file holds its value with no trailing newline, so a password
# and the database URL built from it match byte for byte.
#
# Folder: FOLDER, else ANIMA_SECRETS_DIR, else deploy/secrets beside this script's deploy
# folder. It must belong to the current user and not be writable by group or others.
# ANIMA_SECRETS_CHOWN=0 skips chown (tests, non-root use); modes are still set.
#
# A password you supply must use only A-Z a-z 0-9 . _ ~ - (it goes into a URL unescaped).
# The Cloudflare token comes from the terminal prompt (no echo), from one line of stdin with
# --cloudflare-token-stdin, or from a file you make yourself.
set -eu
umask 077

fail() {
    echo "make-secrets: $*" >&2
    exit 1
}

tmp=
cleanup() {
    if [ -n "$tmp" ]; then rm -f "$tmp"; fi
    stty echo 2>/dev/null || true
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM HUP

token_from_stdin=0
folder_argument=
for argument in "$@"; do
    case $argument in
        --cloudflare-token-stdin) token_from_stdin=1 ;;
        -*) fail "unknown option $argument" ;;
        *) folder_argument=$argument ;;
    esac
done

command -v openssl >/dev/null 2>&1 || fail "openssl is not installed or not on PATH"

here=$(cd "$(dirname "$0")" && pwd)
dir=${folder_argument:-${ANIMA_SECRETS_DIR:-$here/../secrets}}
chown_files=${ANIMA_SECRETS_CHOWN:-1}

mkdir -p "$dir"
dir=$(cd "$dir" && pwd)
[ -n "$(find "$dir" -prune -user "$(id -u)")" ] || fail "$dir does not belong to the current user"
folder_mode=$(ls -ld "$dir")
case $folder_mode in
    ?????w* | ????????w*) fail "$dir is writable by group or others" ;;
    *) ;;
esac

for name in postgres_password owner_password hub_password owner_database_url hub_database_url \
    anima_key cloudflare_dns_token; do
    if [ -L "$dir/$name" ]; then fail "$dir/$name is a symbolic link"; fi
done

# set_access FILE OWNER MODE: owner first, then mode.
set_access() {
    if [ "$chown_files" != 0 ]; then chown "$2" "$1"; fi
    chmod "$3" "$1"
}

# store NAME OWNER MODE VALUE: writes VALUE to a temp file, then moves it into place.
# A file that exists keeps its content and gets the owner and mode again.
store() {
    name=$1 owner=$2 mode=$3 value=$4
    if [ -e "$dir/$name" ]; then
        set_access "$dir/$name" "$owner" "$mode"
        return 0
    fi
    [ -n "$value" ] || fail "no value for $name; nothing stored"
    tmp=$(mktemp "$dir/.$name.XXXXXX")
    printf '%s' "$value" >"$tmp"
    set_access "$tmp" "$owner" "$mode"
    mv "$tmp" "$dir/$name"
    tmp=
    echo "made $name"
}

random_hex() {
    value=$(openssl rand -hex 32) || fail "openssl could not make a random value"
    case $value in
        *[!0-9a-f]*) fail "openssl returned an unexpected value" ;;
        *) ;;
    esac
    [ ${#value} -eq 64 ] || fail "openssl returned a value of the wrong length"
    printf '%s' "$value"
}

random_key() {
    value=$(openssl rand -base64 32) || fail "openssl could not make a random value"
    case $value in
        *[!A-Za-z0-9+/=]*) fail "openssl returned an unexpected value" ;;
        *) ;;
    esac
    # 32 bytes in base64 are 43 characters and one "=".
    [ ${#value} -eq 44 ] || fail "openssl returned a value of the wrong length"
    printf '%s' "$value"
}

# ensure_password NAME: stores a password and leaves it in $password (made or supplied).
ensure_password() {
    if [ -e "$dir/$1" ]; then
        password=$(cat "$dir/$1")
        case $password in
            '' | *[!A-Za-z0-9._~-]*)
                fail "$1 must be non-empty and use only A-Z a-z 0-9 . _ ~ -"
                ;;
            *) ;;
        esac
    else
        password=$(random_hex) || exit 1
    fi
    store "$1" root:999 0440 "$password"
}

hint_group() {
    if command -v getent >/dev/null 2>&1 && getent group "$1" >/dev/null 2>&1; then
        echo "make-secrets: note: gid $1 is also a group on this host ($(getent group "$1" | cut -d: -f1)); the files are readable by its members" >&2
    fi
}

ensure_password postgres_password
ensure_password owner_password
owner_password=$password
ensure_password hub_password
hub_password=$password
store owner_database_url root:10001 0440 "postgres://anima_owner:$owner_password@postgres:5432/anima"
store hub_database_url root:10001 0440 "postgres://anima_hub:$hub_password@postgres:5432/anima"
key=
if [ ! -e "$dir/anima_key" ]; then key=$(random_key) || exit 1; fi
store anima_key root:10001 0440 "$key"

token=
if [ ! -e "$dir/cloudflare_dns_token" ]; then
    if [ "$token_from_stdin" = 1 ]; then
        IFS= read -r token || true
    elif [ -t 0 ]; then
        printf 'Cloudflare API token (Zone DNS Edit on anima.ing; input is hidden): ' >&2
        stty -echo
        IFS= read -r token || true
        stty echo
        printf '\n' >&2
    else
        echo "make-secrets: create $dir/cloudflare_dns_token (root:root, 0400) with the Cloudflare API token, or run this script in a terminal" >&2
    fi
    if [ -z "$token" ] && { [ "$token_from_stdin" = 1 ] || [ -t 0 ]; }; then
        fail "the Cloudflare token is empty; cloudflare_dns_token not written"
    fi
fi
if [ -n "$token" ] || [ -e "$dir/cloudflare_dns_token" ]; then
    store cloudflare_dns_token root:root 0400 "$token"
fi

if [ "$chown_files" != 0 ]; then
    hint_group 999
    hint_group 10001
fi
