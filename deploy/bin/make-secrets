#!/bin/sh
# Makes the Compose secret files the hub deployment needs (DB-002, SEC-004, DNS-003).
#
# Run once on the host, as root. It creates only files that are missing, never overwrites
# one, and never prints a secret value. Every file holds its value with no trailing newline,
# so a password and the database URL built from it match byte for byte.
#
# Folder: first argument, else ANIMA_SECRETS_DIR, else deploy/secrets beside this script's
# deploy folder. ANIMA_SECRETS_CHOWN=0 skips chown (tests, non-root use); modes are still set.
set -eu
umask 077

here=$(cd "$(dirname "$0")" && pwd)
dir=${1:-${ANIMA_SECRETS_DIR:-$here/../secrets}}
chown_files=${ANIMA_SECRETS_CHOWN:-1}

mkdir -p "$dir"
dir=$(cd "$dir" && pwd)
trap 'stty echo 2>/dev/null || true' EXIT

# store NAME OWNER MODE: writes stdin to $dir/NAME unless it exists. Temp file, then mv.
store() {
    name=$1 owner=$2 mode=$3
    if [ -e "$dir/$name" ]; then
        cat >/dev/null
        return 0
    fi
    tmp=$(mktemp "$dir/.$name.XXXXXX")
    # Each store runs in a pipeline subshell, so it removes its own temp file on failure.
    trap 'rm -f "$tmp"' EXIT
    cat >"$tmp"
    chmod "$mode" "$tmp"
    if [ "$chown_files" != 0 ]; then
        chown "$owner" "$tmp"
    fi
    mv "$tmp" "$dir/$name"
    echo "made $name"
}

random_hex() { openssl rand -hex 32 | tr -d '\n'; }

database_url() { printf 'postgres://%s:%s@postgres:5432/anima' "$1" "$(cat "$dir/$2")"; }

random_hex | store postgres_password root:999 0440
random_hex | store owner_password root:999 0440
random_hex | store hub_password root:999 0440
database_url anima_owner owner_password | store owner_database_url root:10001 0440
database_url anima_hub hub_password | store hub_database_url root:10001 0440
openssl rand -base64 32 | tr -d '\n' | store anima_key root:10001 0440

if [ ! -e "$dir/cloudflare_dns_token" ]; then
    if [ -t 0 ]; then
        printf 'Cloudflare API token (Zone DNS Edit on anima.ing; input is hidden): ' >&2
        stty -echo
        read -r token
        stty echo
        printf '\n' >&2
        if [ -z "$token" ]; then
            echo "make-secrets: the token is empty; nothing written for cloudflare_dns_token" >&2
            exit 1
        fi
        printf '%s' "$token" | store cloudflare_dns_token root:root 0400
        token=
    else
        echo "make-secrets: create $dir/cloudflare_dns_token (root:root, 0400) with the Cloudflare API token, or run this script in a terminal"
    fi
fi
