# The password check and the copy to Anima. nginx fills ${ANIMA_OWNTRACKS_URL}.
map "${ANIMA_OWNTRACKS_URL}" $anima_copy {
    ""      0;
    default 1;
}

server {
    listen 8080;
    client_max_body_size 1m;

    auth_basic "OwnTracks";
    auth_basic_user_file /etc/nginx/htpasswd;

    # The phone posts here (OwnTracks HTTP mode).
    location = /pub {
        mirror /anima-copy;
        mirror_request_body on;
        proxy_set_header X-Limit-U $remote_user;
        proxy_set_header X-Limit-D phone;
        proxy_pass http://recorder:8083/pub;
    }

    # The copy for the Anima hub. A fault here does not fail the post of the phone.
    location = /anima-copy {
        internal;
        if ($anima_copy = 0) {
            return 204;
        }
        resolver 127.0.0.11 1.1.1.1 valid=300s;
        include /etc/nginx/anima-authorization;
        proxy_ssl_server_name on;
        proxy_pass ${ANIMA_OWNTRACKS_URL};
    }

    # The map and the API of the Recorder, behind the same password.
    location / {
        proxy_set_header X-Limit-U $remote_user;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_pass http://recorder:8083/;
    }
}
