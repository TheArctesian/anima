# VPS: daily database backup and off-site copy (DB-007, VPS-006).
# Install as /etc/systemd/system/anima-backup.service (see README.md).
[Unit]
Description=Anima database backup and off-site copy
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=2h
ExecStart=/opt/anima/deploy/backup/backup.sh
ExecStart=/opt/anima/deploy/backup/offsite.sh
Environment=ANIMA_RESTIC_CACHE_DIR=%C/anima-offsite
CacheDirectory=anima-offsite
CacheDirectoryMode=0700
UMask=0077
# A core dump of restic could hold the repository password.
LimitCORE=0

# Sandbox. Root runs `docker compose exec` through the Docker socket, so the unit keeps
# access to /run (read-only file system, writable socket) and drops everything else.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/anima
ReadOnlyPaths=/opt/anima
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
