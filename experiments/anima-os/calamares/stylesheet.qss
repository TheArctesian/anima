QWidget { background-color: #2E3440; color: #ECEFF4; }
QLabel { background: transparent; }
QPushButton { background-color: #434C5E; color: #ECEFF4; border: 1px solid #4C566A; border-radius: 5px; padding: 7px 16px; }
QPushButton:hover { background-color: #4C566A; border-color: #88C0D0; }
QPushButton:default { background-color: #5E81AC; color: #ECEFF4; }
QPushButton:disabled { color: #D8DEE9; background-color: #3B4252; }
QLineEdit, QComboBox, QListView, QTreeView { background-color: #3B4252; color: #ECEFF4; border: 1px solid #4C566A; border-radius: 4px; padding: 4px; selection-background-color: #5E81AC; }
QLineEdit:focus, QComboBox:focus { border-color: #88C0D0; }
QProgressBar { background-color: #3B4252; border: 0; text-align: center; }
QProgressBar::chunk { background-color: #88C0D0; }
QToolTip { background-color: #434C5E; color: #ECEFF4; border: 1px solid #88C0D0; }
