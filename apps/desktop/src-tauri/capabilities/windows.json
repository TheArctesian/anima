    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "log:allow-log",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "allow-process-log-folder-open",
    "allow-this-machine-read",
    "allow-link-join",
    "allow-link-status",
    "allow-link-leave",
    "allow-hub-listener-check",
    "allow-system-browser-open",
    "allow-web-view-pinning",
    "allow-web-view-open",
    "allow-web-view-place",
    "allow-web-view-show",
    "allow-web-view-go",
    "allow-web-view-pin",
    "allow-web-view-pop-out",
    "allow-web-view-close",
    "allow-web-certificate-read",
    "allow-mcp-permissions-read",
    "allow-mcp-permissions-write",
    "allow-command-line-read",
    "allow-command-line-install",
    "allow-command-line-remove",
    "allow-mcp-agents-read",
    "allow-mcp-agents-change",
