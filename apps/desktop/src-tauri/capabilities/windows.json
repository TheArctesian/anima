    "allow-local-hub-remove",
    "allow-local-hub-status",
    "allow-local-hub-start",
    "allow-local-hub-stop",
    "allow-local-hub-account",
    "allow-local-hub-totp-new",
    "allow-local-hub-account-create",
    "allow-local-hub-key-save"
