{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": [
      "binaries/anima-link",
      "binaries/anima",
      "binaries/anima-daemon",
      "binaries/anima-local-hub",
      "binaries/anima-hub",
      "binaries/anima-database",
      "binaries/anima-gateway"
    ],
    "resources": {
      "database/": "database/"
    }
  }
}
