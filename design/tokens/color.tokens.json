      "$value": "{color.nord.7}",
      "$description": "Information messages"
    },
    "status-up": {
      "$value": "{color.nord.14}",
      "$description": "Device or check is up"
    },
    "status-down": {
      "$value": "{color.nord.11}",
      "$description": "Device or check is down. Error messages"
    },
