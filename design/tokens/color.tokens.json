    },
    "status-warning": {
      "$value": "{color.nord.12}",
      "$description": "Warnings. Host key changed"
    },
    "status-maintenance": {
      "$value": "{color.nord.15}",
      "$description": "Device is in maintenance"
    },
    "status-unknown": {
      "$value": "{color.nord.3}",
      "$description": "No data, or the check is paused"
