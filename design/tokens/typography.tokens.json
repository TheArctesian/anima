{
  "typeface": {
    "font": {
      "$type": "fontFamily",
      "ui": {
        "$value": [
          "IBM Plex Sans",
          "system-ui",
          "-apple-system",
          "sans-serif"
        ],
        "$description": "Interface text, the default typeface (UI-010, operator change 2026-11-12); the system font is the fallback (UI-021)"
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "Symbols Nerd Font",
          "ui-monospace",
          "monospace"
        ],
        "$description": "IP addresses, host names, code and remote shells: IBM Plex Mono, one family with the interface face; the Nerd Font symbols face draws shell prompt glyphs (UI-011, UR-7 D2)"
      },
      "ui-opendyslexic": {
        "$value": [
          "OpenDyslexic Nerd Font Propo",
          "system-ui",
          "-apple-system",
          "sans-serif"
        ],
        "$description": "Interface text when the operator chooses OpenDyslexic (UI-020)"
      },
      "mono-opendyslexic": {
        "$value": [
          "OpenDyslexicM Nerd Font Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "IP addresses, host names, code when the operator chooses OpenDyslexic (UI-020)"
      },
      "icon": {
        "$value": [
          "OpenDyslexic Nerd Font Propo",
          "Symbols Nerd Font"
        ],
        "$description": "Nerd Font glyph icons (UI-014)"
      }
    }
  },
  "size": {
    "text": {
      "$type": "dimension",
      "xs": {
        "$value": "0.75rem",
        "$description": "Smallest labels"
      },
      "sm": {
        "$value": "0.8125rem",
        "$description": "Dense tables (UI-019)"
      },
      "md": {
        "$value": "0.875rem",
        "$description": "Body text (UI-019)"
      },
      "lg": {
        "$value": "1rem",
        "$description": "Emphasised body, small headings"
      },
      "xl": {
        "$value": "1.25rem",
        "$description": "Headings"
      },
      "2xl": {
        "$value": "1.5rem",
        "$description": "Large headings"
      },
      "display": {
        "$value": "2.25rem",
        "$description": "The title of a top-level page only, in weight-light and tracking-tight (UR-7 D5)"
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": 1.2,
        "$description": "Headings"
      },
      "normal": {
        "$value": 1.5,
        "$description": "Body text (UI-019)"
      },
      "relaxed": {
        "$value": 1.7,
        "$description": "Long reading text"
      }
    },
    "tracking": {
      "$type": "dimension",
      "display": {
        "$value": "-0.01em",
        "$description": "Large text (TOK-021)"
      },
      "body": {
        "$value": "0em",
        "$description": "Body text (TOK-021)"
      },
      "small": {
        "$value": "0.01em",
        "$description": "Small text (TOK-021)"
      },
      "tight": {
        "$value": "-0.03em",
        "$description": "The display title (UR-7 D7)"
      },
      "label": {
        "$value": "0.14em",
        "$description": "Small-caps labels and section heads (UR-7 D7)"
      }
    },
    "weight": {
      "light": {
        "$value": 200,
        "$description": "The display title only, at text-display (UR-7 D1); OpenDyslexic draws it at regular"
      },
      "regular": {
        "$value": 400,
        "$description": "Body text"
      },
      "medium": {
        "$value": 500,
        "$description": "Labels, names and emphasis (UR-7 D1); OpenDyslexic draws it bold, so the hierarchy keeps two weights"
      }
    }
  }
}
