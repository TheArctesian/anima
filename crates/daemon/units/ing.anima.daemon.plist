<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Anima daemon as a LaunchAgent (MET-019). `anima-daemon install` replaces the first ProgramArguments
     string with the path of the binary it runs from. The daemon listens on no port (MET-020).
     launchd keeps no standard error here, so ANIMA_DAEMON_LOG=file makes the daemon write its log to
     ~/Library/Logs/Anima/anima-daemon.log, rotated at 1 MiB with one older file (MET-019). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ing.anima.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/anima-daemon</string>
        <string>run</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ANIMA_DAEMON_LOG</key>
        <string>file</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
