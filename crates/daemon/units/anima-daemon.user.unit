# Anima daemon as a systemd user unit (MET-019). `anima-daemon install` replaces ExecStart's path with
# the path of the binary `anima-daemon install` runs from. The daemon listens on no port (MET-020).
[Unit]
Description=Anima daemon: pushes this computer's metrics to the hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/anima-daemon run
Restart=on-failure
RestartSec=10
# The holder of the agent threads (THR-113) must outlive a stop or a restart of the daemon. Without
# this line, the control-group mode of systemd kills the holder and each program that it runs. Probes
# and `ps` end by their own deadlines. At the next start systemd logs "left-over process"; that is
# expected.
KillMode=process
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%E/anima-daemon
LimitCORE=0
SocketBindDeny=any

[Install]
WantedBy=default.target
