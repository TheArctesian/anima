# Anima agent as a systemd user unit (MET-019). The installer replaces ExecStart's path with
# the place it copied the binary to. The agent listens on no port (MET-020).
[Unit]
Description=Anima agent: pushes this computer's metrics to the hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/anima-agent run
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
