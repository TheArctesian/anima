# Anima agent as a systemd system unit (MET-019). The installer makes the `anima-agent` user
# and group, and replaces ExecStart's path with the place it copied the binary to. The agent
# reads /proc and /sys, runs `df` and the GPU tools, writes only its state directory, and
# listens on no port (MET-002, MET-020). PrivateDevices stays off: nvidia-smi needs /dev/nvidia*.
[Unit]
Description=Anima agent: pushes this computer's metrics to the hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anima-agent
Group=anima-agent
Environment=ANIMA_AGENT_HOME=/var/lib/anima-agent
ExecStart=/usr/local/bin/anima-agent run
Restart=on-failure
RestartSec=10
StateDirectory=anima-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
